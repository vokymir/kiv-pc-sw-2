ZIPNAME = assembler.zip
PDF = $(wildcard doc/doc.pdf)
DOC_TEX = doc/src/doc.tex
SRC_DIR = src
INC_DIR = include
REVERSE_SRC = reverse.bash
MAKEFILE_SRC = makefile_for_kekstein
TMPDIR = tmp_submit

.PHONY: submit clean

submit: clean
	@echo "📦 Creating submission archive..."
	# create temp directory
	mkdir -p $(TMPDIR)
	# copy reverse script to root
	cp $(REVERSE_SRC) $(TMPDIR)/
	# copy PDF to root
	cp $(PDF) $(TMPDIR)/
	# copy doc.tex to root
	cp $(DOC_TEX) $(TMPDIR)/
	# copy src folder
	find $(SRC_DIR) -maxdepth 5 -type f -name '*.c' \
	-exec sh -c ' \
		for f in "$$@"; do \
			g=$$(printf "%s" "$$f" | tr "/" "_" ); \
			cp "$$f" "$(TMPDIR)/$$g"; \
		done \
	' sh {} +
	find $(SRC_DIR) -maxdepth 5 -type f -name '*.h' -exec cp {} $(TMPDIR)/ \;
	# copy includes folder
	cp -r $(INC_DIR)/* $(TMPDIR)/
	# copy makefile_for_kekstein as Makefile
	cp $(MAKEFILE_SRC) $(TMPDIR)/makefile
	# create Windows Makefile variant
	sed 's/rm -f/del /' $(MAKEFILE_SRC) > $(TMPDIR)/makefile.win
	# create zip
	cd $(TMPDIR) && zip -r ../$(ZIPNAME) *
	@echo "✅ Created $(ZIPNAME)"
	# clean temp directory
	rm -rf $(TMPDIR)

clean:
	@rm -f $(ZIPNAME)
	@rm -rf $(TMPDIR)
