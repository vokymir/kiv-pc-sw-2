.KMA
.DATA
	stack_array DWORD 1,2,3,4,5,6,7,8
.CODE
	MOV	C, 0					; CS:000 -> 10 03 00 00 00 00
	MOV	B, OFFSET stack_array	; CS:006 -> 10 02 00 00 00 00
@Pushing:
	LOAD A, B					; CS:012 -> 14 01 02
	PUSH A						; CS:015 -> 20 01
	ADD	 C, 1					; CS:017 -> 30 03 01 00 00 00
	ADD  B, 4					; CS:023 -> 30 02 04 00 00 00
	CMP  C, 8					; CS:029 -> 60 03 08 00 00 00
	JLE  @Pushing				; CS:035 -> 78 E4 FF FF FF    // tj. -28 na pozici CS:012,
	
	MOV  C, 0					; CS:040 -> 10 03 00 00 00 00 // jelikož 40 - 28 = 12.
	MOV  B, OFFSET stack_array
@Popping:
	POP  A
	STOR A, B
	ADD  C, 1
	ADD  B, 4
	CMP  C, 8
	JLE @Popping
	
	MOV  C, 0
	MOV  B, OFFSET stack_array
@Printing:
	LOAD A, B
	ADD  C, 1
	ADD  B, 4
	OUTD A
	CMP C, 8
	JLE @Printing
	HALT