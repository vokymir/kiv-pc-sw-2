.KMA
.DATA
        swapped DWORD ?
        array DWORD 20 DUP(?)
.CODE
        MOV     A, 1
        STOR    A, OFFSET swapped
		MOV		D, OFFSET array
		ADD		D, 8
		MOV		A, 10
		STOR	A, D
		ADD		D, 16
		MOV		A, 20
		STOR	A, D
		ADD		D, 8
		MOV		A, 30
		STOR	A, D
@LBubbleWhileBeg:
        LOAD    A, OFFSET swapped
        CMP     A, 1
        JNE     @LBubbleWhileEnd
@LBubbleForInit:
        MOV     C, 19
        MOV     A, 0
        STOR    A, OFFSET swapped
        MOV     S, OFFSET array
        MOV     D, OFFSET array
        ADD     D, 4
@LBubbleForBeg:
        LOAD    A, S
        LOAD    B, D
        CMP     A, B
        JNG     @L01
        STOR    B, S
        STOR    A, D
        MOV     A, 1
        STOR    A, OFFSET swapped
@L01:
        DEC     C
        ADD     S, 4
        ADD     D, 4	
        CMP     C, 0
        JG      @LBubbleForBeg
@LBubbleForEnd:
        JMP     @LBubbleWhileBeg
@LBubbleWhileEnd:

@LOutputForInit:
        MOV     C, 20
        MOV     S, OFFSET array
@LOutputForBeg:
        LOAD    A, S
        OUTD    A
		ADD		S, 4
        DEC     C
        CMP     C, 0
        JG      @LOutputForBeg
@LOutputForEnd:
        HALT
